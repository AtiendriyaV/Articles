# GOOGLE DRIVE CMS INTEGRATION (Service Account)
# Email of the Google Cloud Service Account
GOOGLE_CLIENT_EMAIL="blog-drive-writer@your-project-id.iam.gserviceaccount.com"

# Private key of the Service Account (including \n escaped newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...YOUR_KEY...\n-----END PRIVATE KEY-----\n"

# The target Google Drive folder ID where markdown files (.md) will be stored
GOOGLE_DRIVE_FOLDER_ID="1a2B3c4D5e6F7g8H9i0jKlMnOpQrStUvW"
